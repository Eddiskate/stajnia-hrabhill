<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}HRABHILL — szkoła jazdy konnej{% endblock %}</title>
    <meta name="description" content="{% block description %}HRABHILL, szkoła jazdy konnej. Jazdy dla dzieci i dorosłych na koniach Rychu, Ksenia, Fruzia i Drago.{% endblock %}">
    <meta name="robots" content="index, follow">
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ block('description') }}">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="pl_PL">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect fill='%231e3328' width='32' height='32'/%3E%3Cpath d='M11 26V8M16 26V5M21 26V10' stroke='%23f4efe4' stroke-width='1.4'/%3E%3C/svg%3E">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,520;0,9..144,640;1,9..144,520&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/site.css') }}">
    {% block head %}{% endblock %}
</head>
<body>
    <a class="skip" href="#tresc">Przejdź do treści</a>
    {% include 'page/_header.html.twig' %}
    <main id="tresc">
        {% block body %}{% endblock %}
    </main>
    {% include 'page/_footer.html.twig' %}
    {% block javascripts %}{% endblock %}
</body>
</html>
